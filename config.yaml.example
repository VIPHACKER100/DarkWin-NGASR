# DARKWIN Configuration Example
# Developed by ARYAN AHIRWAR (VIPHACKER.100)

app:
  name: "DARKWIN"
  version: "2.0.0"
  author: "ARYAN AHIRWAR (VIPHACKER.100)"

database:
  # Primary database URL (PostgreSQL recommended for production)
  # If unreachable, DARKWIN will automatically fallback to local sqlite:///darkwin.db
  url: "postgresql://user:password@localhost:5432/darkwin_db"

redis:
  # Used for distributed mesh and caching
  url: "redis://localhost:6379/0"

ai:
  # LLM reasoning engine settings
  openai_api_key: "sk-..."
  openai_model: "gpt-4-turbo-preview"
  local_llm_url: "http://localhost:11434/v1" # For local Ollama support

tools:
  # Paths to external binary dependencies
  nmap: "nmap"
  subfinder: "subfinder"
  httpx: "httpx"
  nuclei: "nuclei"
  ffuf: "ffuf"
  amass: "amass"
  katana: "katana"
  sqlmap: "sqlmap"
  dalfox: "dalfox"
  masscan: "masscan"
  gau: "gau"
  waybackurls: "waybackurls"

scans:
  output_dir: "reports"
  log_dir: "logs"
  max_threads: 20
  timeout: 3600
  rate_limit: 10 # requests per second (mesh-wide)

api_keys:
  # Passive reconnaissance keys
  shodan: ""
  censys_id: ""
  censys_secret: ""
  virustotal: ""
  github_token: ""

notifications:
  # Webhook URLs for remote alerting
  discord: ""
  slack: ""
  telegram: ""

proxy:
  # Proxy settings for evasion
  proxy_file: "proxies.txt"
  proxies: []
