# DARKWIN Environment Variables Example
# Use double underscores for nested config: CATEGORY__KEY=VALUE

# App Settings
APP__NAME=DARKWIN
APP__VERSION=2.0.0

# Database & Cache
DATABASE__URL=postgresql://user:password@localhost:5432/darkwin_db
REDIS__URL=redis://localhost:6379/0

# AI reasoning engine
AI__OPENAI_API_KEY=sk-...
AI__OPENAI_MODEL=gpt-4-turbo-preview
AI__LOCAL_LLM_URL=http://localhost:11434/v1

# External APIs
API_KEYS__SHODAN=
API_KEYS__CENSYS_ID=
API_KEYS__CENSYS_SECRET=
API_KEYS__VIRUSTOTAL=
API_KEYS__GITHUB_TOKEN=

# Notifications
NOTIFICATIONS__DISCORD=
NOTIFICATIONS__SLACK=
NOTIFICATIONS__TELEGRAM=

# Flask Dashboard Settings
FLASK_ENV=production
FLASK_SECRET_KEY=generate_a_random_string_here
FLASK_PORT=5000
